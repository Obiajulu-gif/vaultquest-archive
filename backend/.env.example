# VaultQuest Backend Environment Variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vaultquest"

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Stellar Network
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production
SESSION_SECRET=your-session-secret-change-in-production

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000

# Redis (optional, for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@vaultquest.io

# Monitoring
PROMETHEUS_METRICS=true
SYNTHETIC_MONITOR_INTERVAL=300000

# Feature Flags
STORE_DRILL_HISTORY=false
ENABLE_API_VERSIONING=true
DEFAULT_API_VERSION=v2

# Schema Evolution
SCHEMA_VERSION_LOGGING=true
QUARANTINE_UNREADABLE_PAYLOADS=true

# Incident Drills
DRILL_ENVIRONMENT=sandbox
DRILL_AUTO_ROLLBACK=true
DRILL_RESULTS_DIR=./drill-results

# Background Jobs
JOB_CONCURRENCY=5
JOB_RETRY_DELAY_MS=5000
JOB_MAX_ATTEMPTS=3

# Recovery Settings
RECOVERY_STALE_THRESHOLD_MS=1800000
RECOVERY_MAX_ATTEMPTS=3
