# Action ledger (issue #34)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vaultquest
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-string
# Replace the placeholder secret with a strong, unique value. The backend rejects placeholder values at boot.
ORPHAN_TTL_MINUTES=10
LOG_LEVEL=info
PORT=3001
NODE_ENV=development
APP_ENV=local
# See docs/env-inventory.md for staging/production requirements and preflight.

# API key for external/third-party service endpoints (issue #273).
# When set, all /api/* routes require the header: X-Api-Key: <value>
# Must be at least 32 characters. Leave unset to disable enforcement in local dev.
# API_KEY=change-me-to-a-long-random-api-key-string

# Automated database backups (issue #275).
# BACKUP_DIR: absolute path where pg_dump files are written.
#   When unset the backup cron is not started and the backup script exits early.
# BACKUP_RETAIN_DAYS: delete backup files older than this many days (default 7).
# BACKUP_SCHEDULE: cron expression for the automated backup job (default: daily at 02:00).
#   Uses standard 5-field cron syntax supported by node-cron.
# BACKUP_DIR=/var/backups/vaultquest
# BACKUP_RETAIN_DAYS=7
# BACKUP_SCHEDULE=0 2 * * *

# Replay-equivalence job (issue #751).
# REPLAY_DATABASE_URL: dedicated scratch database (migrations applied). It is
#   TRUNCATED on every run and must never be the live database. When unset the
#   job is not started.
# REPLAY_SCHEDULE: cron expression for the job (default: daily at 03:30).
# REPLAY_DATABASE_URL=postgres://user:password@localhost:5432/vaultquest_replay
# REPLAY_SCHEDULE=30 3 * * *

# SendGrid email notification service (issues #487, #488)
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourdomain.com

# Background job worker (#771). Set WORKER_ENABLED=false for enqueue-only replicas.
# WORKER_ENABLED=true
# WORKER_POLL_INTERVAL_MS=2000

# Signed activity receipts (#812). Stellar secret seed that signs receipts;
# generate one with `node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"`.
# Unset = ephemeral key per process (receipts stop verifying after a restart).
# RECEIPT_SIGNING_SECRET=S...
# RECEIPT_PREVIOUS_PUBLIC_KEYS=GOLDKEY1,GOLDKEY2

# Stuck pending-action recovery (#813).
# PENDING_STALE_THRESHOLD_MINUTES=30
# RECOVERY_MAX_ATTEMPTS=3

# Operation limits (#815). JSON overrides of the default policies.
# OPERATION_LIMITS={"action.create":{"limit":50,"windowSeconds":60}}

# Signed webhooks and replay-window enforcement (#799)
# WEBHOOK_SECRET: Shared secret for internal/custom HMAC-SHA256 signatures (defaults to INTERNAL_SERVICE_SECRET)
# STRIPE_WEBHOOK_SECRET: Secret for Stripe webhook signature verification (whsec_...)
# STELLAR_WEBHOOK_PUBLIC_KEY: Stellar Ed25519 public key (G...) for verifying oracle/draw callback signatures
# WEBHOOK_TOLERANCE_SECONDS: Allowed drift window for timestamp verification (default: 300)
# WEBHOOK_SECRET=change-me-to-a-long-webhook-secret
# STRIPE_WEBHOOK_SECRET=whsec_test_secret_12345
# STELLAR_WEBHOOK_PUBLIC_KEY=G...
# WEBHOOK_TOLERANCE_SECONDS=300

