NODE_ENV=development
SANDBOX_MODE=true
SANDBOX_SCENARIO=success

# Both URLs intentionally point at the dedicated loopback sandbox database.
DATABASE_URL=postgresql://vaultquest_sandbox:vaultquest_sandbox_local_only@127.0.0.1:55432/vaultquest_sandbox
SANDBOX_DATABASE_URL=postgresql://vaultquest_sandbox:vaultquest_sandbox_local_only@127.0.0.1:55432/vaultquest_sandbox

# Local-only development secret. Do not reuse this value outside the sandbox.
INTERNAL_SERVICE_SECRET=vaultquest_sandbox_local_internal_secret
PORT=3001
LOG_LEVEL=info
WORKER_ENABLED=false